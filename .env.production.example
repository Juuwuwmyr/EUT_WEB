APP_NAME="E.U.T Snack House"
APP_ENV=production
APP_KEY=                        # Run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://yourdomain.com  # Your actual domain or EC2 public IP
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# ── Database (AWS RDS MySQL) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=eut_restaurant
DB_USERNAME=eut_user
DB_PASSWORD=your-strong-password-here

# ── Session & Cache (use database — no Redis needed) ──────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

# ── Queue (database driver — no Redis/SQS needed) ─────────
QUEUE_CONNECTION=database

# ── File Storage (AWS S3) ─────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=ap-southeast-1    # Singapore — closest to Philippines
AWS_BUCKET=eut-snackhouse-assets
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Broadcasting (Reverb WebSocket) ──────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=eut-production
REVERB_APP_KEY=change-this-to-random-32-chars
REVERB_APP_SECRET=change-this-to-random-32-chars
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=https               # Use https in production

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=yourdomain.com   # Must be public domain, not localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=https

# ── Mail (Gmail SMTP) ─────────────────────────────────────
# Create an App Password at: https://myaccount.google.com/apppasswords
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ventiletos@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM_ADDRESS="ventiletos@gmail.com"
MAIL_FROM_NAME="E.U.T Snack House"

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

VITE_APP_NAME="${APP_NAME}"

# EUT Kitchen Print Server Config
# Copy this to .env and fill in your values

# Laravel app URL (use HTTPS)
APP_URL=https://kalukuhan.duckdns.org

# Token from Laravel .env PRINT_SERVER_TOKEN
PRINT_TOKEN=eut-print-secret-2024

# Printer interface: usb, network, or serial
# For USB thermal printer on Windows: use COM port or printer name
PRINTER_TYPE=usb
PRINTER_INTERFACE=\\.\COM3

# Alternative options:
# For USB by printer name (Windows):
# PRINTER_INTERFACE=POS-80
# For network printer:
# PRINTER_TYPE=network
# PRINTER_INTERFACE=tcp://192.168.1.100

# Poll interval in milliseconds (3000 = 3 seconds)
POLL_INTERVAL=3000

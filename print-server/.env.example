# EUT Kitchen Print Server Config
# Copy this to .env and fill in your values

# Laravel app URL
APP_URL=http://osas-delivery.duckdns.org

# Token from Laravel .env PRINT_SERVER_TOKEN
PRINT_TOKEN=eut-print-secret-2024

# Printer interface: usb, network, or serial
# For USB thermal printer on Windows: use printer name e.g. "POS-80"
# For network printer: use tcp://192.168.1.100
PRINTER_TYPE=usb
PRINTER_INTERFACE=\\.\COM3
# Or for USB by name (Windows):
# PRINTER_INTERFACE=POS-80

# Poll interval in milliseconds (3000 = 3 seconds)
POLL_INTERVAL=3000
